# Mobicycle — Backend (variáveis locais)
# Copie para .env e preencha os valores

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mobicyclo
DB_PASSWORD=mobicyclo123
DB_NAME=mobicyclo
# DB_POOL_SIZE=10

# Redis (opcional em dev; rate limit cai em RAM se indisponível)
REDIS_URL=redis://127.0.0.1:6379
# REDIS_DISABLED=1

# Auth
JWT_SECRET=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
APP_PUBLIC_URL=http://localhost:3000
MERCADOPAGO_WEBHOOK_SECRET=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mobicycle.local

# Opcional: geração de logo via Gemini (rota admin)
GEMINI_API_KEY=
