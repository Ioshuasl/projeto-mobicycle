      const vouchers = db.prepare("SELECT id, code, amount, owner_id as ownerId, recipient_id as recipientId, recipient_email as recipientEmail, recipient_phone as recipientPhone, status, created_at as createdAt FROM vouchers WHERE owner_id = ? OR recipient_id = ? ORDER BY created_at DESC").all(req.user.id, req.user.id);
      res.json(vouchers);
    } catch (err) {
      res.status(500).json({ error: "Erro ao buscar vouchers" });
    }
