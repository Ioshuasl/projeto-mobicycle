  app.get("/api/matrices", authenticateUser, (req: any, res) => {
    const timestamp = new Date().toISOString();
    console.log(`[${timestamp}] GET /api/matrices - Start`);
    try {
      const isAdmin = isUserAdmin(req.user);
      const type = req.query.type as string;

      let matricesWithPositions = [];
      const page = parseInt(req.query.page as string) || 1;
      const limit = parseInt(req.query.limit as string) || 10;
      const offset = (page - 1) * limit;
      
      if (isAdmin) {
        let query = "SELECT * FROM matrices WHERE status = 'OPEN'";
        let params: any[] = [];
        if (type) {
          query += " AND type = ?";
          params.push(type);
        }
        query += " ORDER BY created_at DESC LIMIT ? OFFSET ?";
        params.push(limit, offset);
        
        const matrices = db.prepare(query).all(...params);
        if (matrices.length > 0) {
          const matrixIds = matrices.map((m: any) => m.id);
          const placeholders = matrixIds.map(() => '?').join(',');
          const allPositions = db.prepare(`
            SELECT mp.matrix_id, mp.position, mp.user_id as userId, u.name as name, u.nickname as nickname, u.referrals_count as referralsCount, u.status as status, u.career_level as careerLevel, u.balance as balance, u.cycle_sales_count as cycleSalesCount
            FROM matrix_positions mp 
            JOIN users u ON mp.user_id = u.id 
            WHERE mp.matrix_id IN (${placeholders})
          `).all(...matrixIds);

          const positionsByMatrix = allPositions.reduce((acc: any, p: any) => {
            if (!acc[p.matrix_id]) acc[p.matrix_id] = [];
            acc[p.matrix_id].push({
              ...p,
              userName: p.name,
              userNickname: p.nickname
            });
            return acc;
          }, {});

          matricesWithPositions = matrices.map((m: any) => ({
            ...m,
            positions: positionsByMatrix[m.id] || []
          }));
        }
      } else {
        let query = `
          SELECT DISTINCT m.* 
          FROM matrices m 
          JOIN matrix_positions mp ON m.id = mp.matrix_id 
          WHERE m.status = 'OPEN' AND mp.user_id = ?
        `;
        let params: any[] = [req.user.id];
        if (type) {
          query += " AND m.type = ?";
          params.push(type);
        }
        
        const matrices = db.prepare(query).all(...params);

        if (matrices.length > 0) {
          const allPositions = db.prepare(`
            SELECT mp.matrix_id, mp.position, mp.user_id as userId, u.name as name, u.nickname as nickname, u.referrals_count as referralsCount, u.status as status, u.career_level as careerLevel, u.balance as balance, u.cycle_sales_count as cycleSalesCount
            FROM matrix_positions mp 
            JOIN users u ON mp.user_id = u.id 
            WHERE mp.matrix_id IN (
              SELECT matrix_id FROM matrix_positions WHERE user_id = ?
            )
          `).all(req.user.id);

          const positionsByMatrix = allPositions.reduce((acc: any, p: any) => {
            if (!acc[p.matrix_id]) acc[p.matrix_id] = [];
            acc[p.matrix_id].push({
              ...p,
              userName: p.name,
              userNickname: p.nickname
            });
            return acc;
          }, {});

          matricesWithPositions = matrices.map((m: any) => ({
            ...m,
            positions: positionsByMatrix[m.id] || []
          }));
        }
      }
      
      console.log(`[${timestamp}] GET /api/matrices - Found ${matricesWithPositions.length} matrices`);
      res.json(matricesWithPositions);
    } catch (err) {
      console.error(`[${timestamp}] Error in /api/matrices:`, err);
      res.status(500).json({ 
        error: "Erro ao buscar matrizes", 
        details: err instanceof Error ? err.message : String(err) 
      });
    }
  });

  // Helper functions moved to Managers and Utils

  app.post("/api/matrices/join", authenticateUser, (req: any, res) => {
    try {
      const { userId, referrerId } = req.body;

      // Authorization check
      if (req.user.id !== userId && !isUserAdmin(req.user)) {
        return res.status(403).json({ error: "Acesso negado" });
      }

      // Rule: Only one active position allowed in the entire system
      const activePosition = db.prepare("SELECT mp.matrix_id FROM matrix_positions mp JOIN matrices m ON mp.matrix_id = m.id WHERE mp.user_id = ? AND m.status = 'OPEN'").get(userId);
      if (activePosition) {
        return res.status(400).json({ error: "Você já possui uma posição ativa no sistema (On-Board ou Cash-Board). Aguarde o ciclo para reentrar." });
      }

      // Matrix formation logic
      const formationRule = getSetting('matrix_formation_rule', 'FILL_BASE');
      let matrix = null;

      if (formationRule === 'FOLLOW_REFERRER') {
        if (referrerId) {
          const referrerMatrix = db.prepare(`
            SELECT m.id 
            FROM matrices m 
            JOIN matrix_positions mp ON m.id = mp.matrix_id 
            WHERE mp.user_id = ? AND m.type = 'ONBORD' AND m.status = 'OPEN'
            LIMIT 1
          `).get(referrerId);
          if (referrerMatrix) matrix = referrerMatrix;
        }
      }

      if (!matrix) {
        const openMatrices = db.prepare("SELECT id FROM matrices WHERE type = 'ONBORD' AND status = 'OPEN' ORDER BY created_at ASC").all();
        matrix = openMatrices.length > 0 ? openMatrices[0] : null;
      }

      if (!matrix) {
        matrix = MatrixManager.createMatrix('ONBORD');
      }
      const existing = db.prepare("SELECT * FROM matrix_positions WHERE matrix_id = ? AND user_id = ?").get(matrix.id, userId);
      if (existing) return res.status(400).json({ error: "Usuário já está nesta matriz" });

      // Handle referral
      if (referrerId && referrerId !== userId) {
        FinancialManager.addReferralBonus(referrerId, userId);
        const adhesionFee = parseFloat(getSetting('matrix_adhesion_fee', '650'));
        // Pay infinite bonus on the sale
        FinancialManager.payInfiniteBonus(userId, adhesionFee);
        // Pay 8-level unilevel bonus on the sale
        FinancialManager.payLicenseUnilevelBonus(userId);
      }

      const result = MatrixManager.fillPosition(matrix.id, userId);
      if (result.error) return res.status(400).json(result);

      // Increment network sales for ancestors
      FinancialManager.incrementNetworkSales(userId);

      // Update user status to BRONZE upon joining first matrix
      db.prepare("UPDATE users SET status = 'BRONZE' WHERE id = ? AND status = 'PARTNER'").run(userId);

      res.json({ success: true, cycleInfo: result.cycleInfo });
    } catch (err) {
      console.error("Error in /api/matrices/join:", err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.get("/api/admin/matrices/summary", authenticateUser, authorizeAdmin, (req, res) => {
