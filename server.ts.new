import express from "express";
import { createServer as createViteServer } from "vite";
import path from "path";
import fs from "fs";
import { fileURLToPath } from "url";
import { sendNotificationEmail } from "./email.ts";
import { parseStringPromise } from 'xml2js';
import { GoogleGenAI } from "@google/genai";

import { db, hashPassword, getSetting, ensureSetting, generateId } from "./src/server/db.ts";
import { NotificationManager } from "./src/server/notificationManager.ts";
import { AchievementManager } from "./src/server/achievementManager.ts";
import { FinancialManager } from "./src/server/financialManager.ts";
import { MatrixManager } from "./src/server/matrixManager.ts";
import { UserManager } from "./src/server/userManager.ts";
import { validateCPF, generateReferralCode, updateCareerLevel } from "./src/server/utils.ts";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const SESE_CNPJ = "47.123.456/0001-89";

async function startServer() {
  // Update career levels for all users on startup
  const allUsers = db.prepare("SELECT id FROM users").all() as any[];
  for (const u of allUsers) {
    updateCareerLevel(u.id);
  }

  // Ensure all users have a referral code
  const usersWithoutCode = db.prepare("SELECT id, name FROM users WHERE referral_code IS NULL").all() as any[];
  for (const user of usersWithoutCode) {
    const code = generateReferralCode(user.name || 'USER');
    db.prepare("UPDATE users SET referral_code = ? WHERE id = ?").run(code, user.id);
  }

  const app = express();
  const PORT = 3000;

  // Security Middlewares
  const authenticateUser = (req: any, res: any, next: any) => {
    const userId = req.headers['x-user-id'] as string;
    if (!userId || userId === 'null' || userId === 'undefined') {
      return res.status(401).json({ error: "Não autenticado" });
    }
    
    const user = db.prepare("SELECT id, role, email, status FROM users WHERE id = ?").get(userId) as any;
    if (!user) {
      return res.status(401).json({ error: "Não autenticado" });
    }
    
    req.user = user;
    next();
  };

  const isUserAdmin = (user: any) => {
    if (!user) return false;
    return user.role === 'admin' || 
           user.email === 'consultorcredenciado@gmail.com' || 
           user.email === 'admin@wayfy.com' ||
           user.status === 'MASTER';
  };

  const authorizeAdmin = (req: any, res: any, next: any) => {
    if (!isUserAdmin(req.user)) {
      return res.status(403).json({ error: "Acesso negado. Apenas administradores podem realizar esta ação." });
    }
    next();
  };

  // SYSTEM RESET (UNCOMMENT TO RESET)
  /*
  try {
    console.log("DEBUG: [STARTUP] FORCE RESET triggered");
    db.transaction(() => {
      db.prepare("DELETE FROM matrix_positions").run();
      db.prepare("DELETE FROM matrices").run();
      db.prepare("DELETE FROM matrix_cycles").run();
      db.prepare("DELETE FROM transactions").run();
      db.prepare("DELETE FROM notifications").run();
      db.prepare("DELETE FROM documents").run();
      db.prepare("DELETE FROM vouchers").run();
      db.prepare("DELETE FROM badges").run();
      db.prepare("DELETE FROM user_badges").run();
      db.prepare("DELETE FROM matrix_history").run();
      db.prepare("DELETE FROM users WHERE id NOT LIKE 'sys_%' AND email != 'consultorcredenciado@gmail.com'").run();
      db.prepare("UPDATE users SET balance = 0, debt_balance = 0, cashback_balance = 0, voucher_balance = 0, referrals_count = 0, cycle_sales_count = 0, stars = 0, career_level = 'NONE', status = 'PARTNER', cashboard_qualified_referrals = 0").run();
      db.prepare("UPDATE users SET status = 'MASTER' WHERE id LIKE 'sys_%' OR email = 'consultorcredenciado@gmail.com'").run();

      // Create initial matrices
      const onbordId = "matrix_onbord_initial";
      const cashboardId = "matrix_cashboard_initial";
      
      db.prepare("INSERT INTO matrices (id, type, status) VALUES (?, ?, ?)").run(onbordId, 'ONBORD', 'OPEN');
      db.prepare("INSERT INTO matrices (id, type, status) VALUES (?, ?, ?)").run(cashboardId, 'CASHBOARD', 'OPEN');

      // Position admin in matrices
      db.prepare("INSERT INTO matrix_positions (matrix_id, user_id, position) VALUES (?, ?, ?)").run(onbordId, 'sys_admin_001', 1);
      db.prepare("INSERT INTO matrix_positions (matrix_id, user_id, position) VALUES (?, ?, ?)").run(cashboardId, 'sys_admin_001', 1);
    })();
    console.log("DEBUG: [STARTUP] Reset complete");
  } catch (err) {
    console.error("Error during startup reset:", err);
  }
  */

  app.use(express.json({ limit: '50mb' }));
  app.use(express.urlencoded({ limit: '50mb', extended: true }));

  // API Routes
  app.get("/api/health", (req, res) => {
    res.json({ status: "ok", env: process.env.NODE_ENV });
  });

  app.post("/api/auth/forgot-password", (req, res) => {
    try {
      const { email, cpf } = req.body;
      const user = db.prepare("SELECT id FROM users WHERE email = ? AND cpf = ?").get(email, cpf) as any;
      if (!user) {
        return res.status(404).json({ error: "Usuário não encontrado com estes dados" });
      }
      // In a real app, we would send a token via email. 
      // For this prototype, we'll return a temporary reset token (which is just the userId for now, but we'll secure the reset route)
      res.json({ success: true, resetToken: user.id });
    } catch (err) {
      res.status(500).json({ error: "Erro ao processar recuperação" });
    }
  });

  app.post("/api/auth/reset-password", (req, res) => {
    try {
      const { resetToken, newPassword } = req.body;
      if (!resetToken || !newPassword) {
        return res.status(400).json({ error: "Dados incompletos" });
      }
      
      // In this prototype, resetToken is the userId. 
      // We should at least verify the user exists.
      const user = db.prepare("SELECT id FROM users WHERE id = ?").get(resetToken);
      if (!user) {
        return res.status(404).json({ error: "Token de recuperação inválido" });
      }

      const hashedPassword = hashPassword(newPassword);
      db.prepare("UPDATE users SET password = ? WHERE id = ?").run(hashedPassword, resetToken);
      res.json({ success: true });
    } catch (err) {
      res.status(500).json({ error: "Erro ao redefinir senha" });
    }
  });

  app.get("/api/users/:id", authenticateUser, (req: any, res) => {
    try {
      const { id } = req.params;
      
      // Authorization check: User can only view their own profile unless they are admin
      if (req.user.id !== id && !isUserAdmin(req.user)) {
        return res.status(403).json({ error: "Acesso negado" });
      }

      const user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, cycle_sales_count as cycleSalesCount, balance, debt_balance as debtBalance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, total_earnings as totalEarnings, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE id = ?").get(id);
      
      if (!user) {
        return res.status(404).json({ error: "Usuário não encontrado" });
      }
      res.json(user);
    } catch (err) {
      console.error("Error in /api/users/:id:", err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.get("/api/me", authenticateUser, (req: any, res) => {
    console.log(`[${new Date().toISOString()}] GET /api/me - Start`);
    try {
      const user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, cycle_sales_count as cycleSalesCount, balance, debt_balance as debtBalance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, total_earnings as totalEarnings, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE id = ?").get(req.user.id);
      
      if (!user) {
        return res.status(401).json({ error: "Não autenticado" });
      }
      console.log(`[${new Date().toISOString()}] GET /api/me - Success for user ${user.id}. Balance: ${user.balance}, Cashback: ${user.cashback_balance}, Snack: ${user.snack_fast_cashback}`);
      res.json(user);
    } catch (err) {
      console.error(`[${new Date().toISOString()}] Error in /api/me:`, err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.get("/api/init", authenticateUser, (req: any, res) => {
    const timestamp = new Date().toISOString();
    try {
      const user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, cycle_sales_count as cycleSalesCount, balance, debt_balance as debtBalance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, total_earnings as totalEarnings, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE id = ?").get(req.user.id) as any;
      
      if (!user) {
        return res.status(401).json({ error: "Não autenticado" });
      }

      console.log(`[${timestamp}] GET /api/init - User found: ${user.name}`);

      // Matrices
      const isAdmin = isUserAdmin(user);
      
      let matricesWithPositions = [];
      try {
        let matrices;
        if (isAdmin) {
          // For admins, we fetch all open matrices but we'll join them directly to avoid parameter limits
          matrices = db.prepare("SELECT * FROM matrices WHERE status = 'OPEN' AND type = 'ONBORD'").all();
          
          if (matrices.length > 0) {
            const allPositions = db.prepare(`
              SELECT mp.matrix_id, mp.position, mp.user_id as userId, u.name as name, u.nickname as nickname, u.referrals_count as referralsCount, u.status as status, u.career_level as careerLevel, u.balance as balance, u.cycle_sales_count as cycleSalesCount
              FROM matrix_positions mp 
              JOIN users u ON mp.user_id = u.id 
              JOIN matrices m ON mp.matrix_id = m.id
              WHERE m.status = 'OPEN' AND m.type = 'ONBORD'
            `).all();

            const positionsByMatrix = allPositions.reduce((acc: any, p: any) => {
              if (!acc[p.matrix_id]) acc[p.matrix_id] = [];
              acc[p.matrix_id].push({
                ...p,
                userName: p.name,
                userNickname: p.nickname
              });
              return acc;
            }, {});

            matricesWithPositions = matrices.map((m: any) => ({
              ...m,
              positions: positionsByMatrix[m.id] || []
            }));
          }
        } else {
          // For regular users, they only see matrices they are in
          matrices = db.prepare(`
            SELECT DISTINCT m.* 
            FROM matrices m 
            JOIN matrix_positions mp ON m.id = mp.matrix_id 
            WHERE m.status = 'OPEN' AND mp.user_id = ? AND m.type = 'ONBORD'
          `).all(req.user.id);

          if (matrices.length > 0) {
            // Use a subquery to avoid passing many IDs as parameters
            const allPositions = db.prepare(`
              SELECT mp.matrix_id, mp.position, mp.user_id as userId, u.name as name, u.nickname as nickname, u.referrals_count as referralsCount, u.status as status, u.career_level as careerLevel, u.balance as balance, u.cycle_sales_count as cycleSalesCount
              FROM matrix_positions mp 
              JOIN users u ON mp.user_id = u.id 
              WHERE mp.matrix_id IN (
                SELECT matrix_id FROM matrix_positions WHERE user_id = ?
              ) AND mp.matrix_id IN (SELECT id FROM matrices WHERE type = 'ONBORD')
            `).all(req.user.id);

            const positionsByMatrix = allPositions.reduce((acc: any, p: any) => {
              if (!acc[p.matrix_id]) acc[p.matrix_id] = [];
              acc[p.matrix_id].push({
                ...p,
                userName: p.name,
                userNickname: p.nickname
              });
              return acc;
            }, {});

            matricesWithPositions = matrices.map((m: any) => ({
              ...m,
              positions: positionsByMatrix[m.id] || []
            }));
          }
        }
        console.log(`[${timestamp}] GET /api/init - Found ${matricesWithPositions.length} matrices with positions`);
      } catch (matrixErr) {
        console.error(`[${timestamp}] Error fetching matrices in /api/init:`, matrixErr);
        // Continue without matrices if they fail, rather than crashing the whole init
        matricesWithPositions = [];
      }

      // Notifications
      const notifications = db.prepare("SELECT * FROM notifications WHERE user_id = ? ORDER BY id DESC LIMIT 50").all(req.user.id);

      // Transactions
      const transactions = db.prepare("SELECT * FROM transactions WHERE user_id = ? ORDER BY id DESC").all(req.user.id);
      const uniqueTransactions = Array.from(new Map(transactions.map((t: any) => [t.id, t])).values());

      // Banner and Logo
      const banner = db.prepare("SELECT value FROM settings WHERE key = 'banner_url'").get() as any;
      const logo = db.prepare("SELECT value FROM settings WHERE key = 'logo_url'").get() as any;
      const bannerUrl = banner?.value || 'https://images.unsplash.com/photo-1593941707882-a5bba14938c7?q=80&w=2070&auto=format&fit=crop';
      const logoUrl = logo?.value || '';

      // History
      const history = db.prepare(`
        SELECT DISTINCT m.* 
        FROM matrices m 
        JOIN matrix_positions mp ON m.id = mp.matrix_id 
        WHERE m.status = 'CLOSED' AND mp.user_id = ?
        ORDER BY m.id DESC
      `).all(req.user.id);

      // Documents
      const documents = db.prepare("SELECT * FROM documents WHERE user_id = ?").all(req.user.id);

      // Matrix Settings
      const matrixSettings = {
        adhesionFee: parseFloat(getSetting('matrix_adhesion_fee', '650')),
        onboardBonus: parseFloat(getSetting('matrix_onboard_bonus', '100')),
        cashboardBonus: parseFloat(getSetting('matrix_cashboard_bonus', '3990')),
        referralBonus: parseFloat(getSetting('matrix_referral_bonus', '100')),
        minReferralsToCycle: parseInt(getSetting('matrix_min_referrals_to_cycle', '2')),
        flowEconomy: parseFloat(getSetting('flow_economy', '0')),
        themeNeonGreen: getSetting('theme_neon_green', '#39ff14'),
        themeNeonBlue: getSetting('theme_neon_blue', '#00f3ff'),
        themeNeonPurple: getSetting('theme_neon_purple', '#bc13fe'),
        themeNeonOrange: getSetting('theme_neon_orange', '#ff6700'),
        themeNeonPink: getSetting('theme_neon_pink', '#ff00ff'),
        // Service Visibility and Enabled Status
        service_corridas_visible: getSetting('service_corridas_visible', 'true'),
        service_corridas_enabled: getSetting('service_corridas_enabled', 'true'),
        service_snack_visible: getSetting('service_snack_visible', 'true'),
        service_snack_enabled: getSetting('service_snack_enabled', 'true'),
        service_energy_visible: getSetting('service_energy_visible', 'true'),
        service_energy_enabled: getSetting('service_energy_enabled', 'true'),
        service_guincho_visible: getSetting('service_guincho_visible', 'true'),
        service_guincho_enabled: getSetting('service_guincho_enabled', 'true'),
        service_bonus_hability_test_visible: getSetting('service_bonus_hability_test_visible', 'true'),
        service_bonus_hability_test_enabled: getSetting('service_bonus_hability_test_enabled', 'true'),
        service_mecanica_visible: getSetting('service_mecanica_visible', 'true'),
        service_mecanica_enabled: getSetting('service_mecanica_enabled', 'true'),
        // Service Prices
        service_guincho_urbano_price: getSetting('service_guincho_urbano_price', '180'),
        service_guincho_interurbano_price: getSetting('service_guincho_interurbano_price', '450'),
        service_assistencia_mensal_price: getSetting('service_assistencia_mensal_price', '85'),
        service_corridas_curta_price: getSetting('service_corridas_curta_price', '15'),
        service_corridas_media_price: getSetting('service_corridas_media_price', '35'),
        service_corridas_longa_price: getSetting('service_corridas_longa_price', '75'),
        service_snack_rapido_price: getSetting('service_snack_rapido_price', '25'),
        service_snack_completa_price: getSetting('service_snack_completa_price', '55'),
        service_snack_familia_price: getSetting('service_snack_familia_price', '120'),
        service_energy_drink_price: getSetting('service_energy_drink_price', '12'),
        service_energy_kit_price: getSetting('service_energy_kit_price', '150'),
        service_energy_plano_price: getSetting('service_energy_plano_price', '290'),
        service_bonus_hability_test_price_1: getSetting('service_bonus_hability_test_price_1', '100'),
        service_bonus_hability_test_price_2: getSetting('service_bonus_hability_test_price_2', '250'),
        service_bonus_hability_test_price_3: getSetting('service_bonus_hability_test_price_3', '500'),
        service_mecanica_price_1: getSetting('service_mecanica_price_1', '50'),
        service_mecanica_price_2: getSetting('service_mecanica_price_2', '150'),
        service_mecanica_price_3: getSetting('service_mecanica_price_3', '300')
      };

      console.log(`[${timestamp}] GET /api/init - Success`);

      res.json({
        user,
        matrices: matricesWithPositions,
        notifications,
        transactions: uniqueTransactions,
        banner: { url: bannerUrl },
        logo: { url: logoUrl },
        history,
        documents,
        matrixSettings
      });
    } catch (err) {
      console.error(`[${timestamp}] Error in /api/init:`, err);
      res.status(500).json({ error: "Erro interno do servidor", details: err instanceof Error ? err.message : String(err) });
    }
  });

  // Helper functions moved to Managers and Utils

  app.post("/api/auth/login", (req, res) => {
    try {
      const { email, password, firebaseUid } = req.body;
      let user;
      
      if (firebaseUid) {
        user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, balance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE firebase_uid = ?").get(firebaseUid);
      } else {
        const hashedPassword = hashPassword(password);
        user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, balance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE email = ? AND (password = ? OR password = ?)").get(email, hashedPassword, password);
        
        // If logged in with plain text password, update it to hashed
        if (user && password && db.prepare("SELECT password FROM users WHERE id = ?").get(user.id).password === password) {
          db.prepare("UPDATE users SET password = ? WHERE id = ?").run(hashedPassword, user.id);
        }
      }
      
      if (!user) {
        return res.status(401).json({ error: "Usuário não encontrado ou credenciais inválidas" });
      }
      res.json(user);
    } catch (err) {
      console.error("Error in /api/auth/login:", err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.post("/api/auth/register", (req, res) => {
    try {
      const { name, nickname, email, password, cpf, phone, birthDate, referrerId, referralCode, firebaseUid } = req.body;
      
      // Validate CPF
      if (!validateCPF(cpf)) {
        return res.status(400).json({ error: "CPF inválido. Por favor, insira um CPF verdadeiro." });
      }

      // Check if email already exists
      const existingEmail = db.prepare("SELECT id FROM users WHERE email = ?").get(email);
      if (existingEmail) {
        return res.status(400).json({ error: "Este e-mail já está cadastrado." });
      }

      // Check if CPF already exists
      const existingCPF = db.prepare("SELECT id FROM users WHERE cpf = ?").get(cpf);
      if (existingCPF) {
        return res.status(400).json({ error: "Este CPF já está cadastrado." });
      }

      // Check if Firebase UID already exists
      if (firebaseUid) {
        const existingFirebase = db.prepare("SELECT id FROM users WHERE firebase_uid = ?").get(firebaseUid);
        if (existingFirebase) {
          return res.status(400).json({ error: "Este usuário já possui um cadastro vinculado." });
        }
      }

      let finalReferrerId = referrerId;
      if (referralCode && !finalReferrerId) {
        const referrer = db.prepare("SELECT id FROM users WHERE referral_code = ?").get(referralCode) as any;
        if (referrer) {
          finalReferrerId = referrer.id;
        } else {
          return res.status(400).json({ error: "Código de indicação inválido." });
        }
      }

      const id = generateId("user");
      const newReferralCode = generateReferralCode(name);
      const hashedPassword = password ? hashPassword(password) : null;
      
      db.prepare("INSERT INTO users (id, firebase_uid, name, nickname, email, password, cpf, phone, birth_date, referrer_id, referral_code, is_activated) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0)").run(
        id, firebaseUid || null, name, nickname, email, hashedPassword, cpf, phone, birthDate, finalReferrerId || null, newReferralCode
      );

      // Check for pending vouchers sent to this email or phone
      const pendingVouchers = db.prepare("SELECT id, amount FROM vouchers WHERE (recipient_email = ? OR recipient_phone = ?) AND status = 'SENT'").all(email, phone) as any[];
      for (const v of pendingVouchers) {
        db.prepare("UPDATE vouchers SET owner_id = ?, recipient_id = ?, recipient_email = NULL, recipient_phone = NULL WHERE id = ?").run(id, id, v.id);
        NotificationManager.createNotification(id, 'VOUCHER_RECEIVED', `Você recebeu um voucher de presente de R$ ${v.amount.toFixed(2)} que estava aguardando seu cadastro! 🎁`);
      }

      const user = db.prepare("SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, referrals_count as referralsCount, balance, cashback_balance, snack_fast_cashback, energy_cashback, guincho_cashback, hability_test_cashback, mecanica_cashback, voucher_balance as voucherBalance, document_status as documentStatus, stars, status, career_level as careerLevel, referral_code as referralCode, referrer_id as referrerId, reentry_mode as reentryMode, role, is_activated as isActivated FROM users WHERE id = ?").get(id);
      res.json(user);
    } catch (err) {
      console.error("Error in /api/auth/register:", err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.post("/api/user/update", authenticateUser, (req: any, res) => {
    try {
      const { id, name, nickname, email, phone, pixKey, birthDate, avatar, reentryMode, bankName, bankAgency, bankAccount, bankAccountType } = req.body;
      
      // Authorization check: User can only update their own profile unless they are admin
      if (req.user.id !== id && !isUserAdmin(req.user)) {
        return res.status(403).json({ error: "Acesso negado" });
      }

      // Check if email already exists for another user
      const existingEmail = db.prepare("SELECT id FROM users WHERE email = ? AND id != ?").get(email, id);
      if (existingEmail) {
        return res.status(400).json({ error: "Este e-mail já está sendo usado por outra conta." });
      }

      db.prepare(`
        UPDATE users 
        SET name = ?, nickname = ?, email = ?, phone = ?, pix_key = ?, birth_date = ?, avatar = ?, reentry_mode = ?,
            bank_name = ?, bank_agency = ?, bank_account = ?, bank_account_type = ?
        WHERE id = ?
      `).run(
        name, nickname, email, phone, pixKey, birthDate, avatar, reentryMode || 'AUTO',
        bankName, bankAgency, bankAccount, bankAccountType, id
      );
      const user = db.prepare(`
        SELECT id, name, nickname, email, cpf, phone, pix_key as pixKey, birth_date as birthDate, avatar, 
               referrals_count as referralsCount, balance, cashback_balance, snack_fast_cashback, energy_cashback, voucher_balance as voucherBalance, 
               document_status as documentStatus, stars, status, career_level as careerLevel, 
               referral_code as referralCode, reentry_mode as reentryMode,
               bank_name as bankName, bank_agency as bankAgency, bank_account as bankAccount, bank_account_type as bankAccountType,
               is_activated as isActivated
        FROM users 
        WHERE id = ?
      `).get(id);
      res.json(user);
    } catch (err) {
      console.error("Error in /api/user/update:", err);
      res.status(500).json({ error: "Erro interno do servidor" });
    }
  });

  app.post("/api/user/activate", authenticateUser, (req: any, res) => {
    try {
      const { userId } = req.body;
      if (req.user.id !== userId && !isUserAdmin(req.user)) {
        return res.status(403).json({ error: "Acesso negado" });
      }

      const user = db.prepare("SELECT * FROM users WHERE id = ?").get(userId) as any;
      if (!user) {
        return res.status(404).json({ error: "Usuário não encontrado" });
      }

      if (user.is_activated) {
        return res.status(400).json({ error: "Licença já está ativa" });
      }

      db.prepare("UPDATE users SET is_activated = 1 WHERE id = ?").run(userId);
      
      const adhesionFee = parseFloat(getSetting('matrix_adhesion_fee', '650'));
      
      // Record the transaction
      db.prepare("INSERT INTO transactions (id, user_id, amount, type, description, status) VALUES (?, ?, ?, 'ADHESION', 'Ativação de Licença de Uso', 'COMPLETED')").run(
        generateId("tx"), userId, adhesionFee
      );

      // Pay bonuses
      if (user.referrer_id) {
        FinancialManager.addReferralBonus(user.referrer_id, userId);
        FinancialManager.payLicenseUnilevelBonus(userId);
        FinancialManager.payInfiniteBonus(userId, adhesionFee);
      }

      // Add user to ONBORD matrix
      const openMatrices = db.prepare("SELECT id FROM matrices WHERE type = 'ONBORD' AND status = 'OPEN' ORDER BY created_at ASC").all() as any[];
      let targetMatrix = openMatrices.length > 0 ? openMatrices[0] : null;
      if (!targetMatrix) {
        targetMatrix = MatrixManager.createMatrix('ONBORD');
      }
      MatrixManager.fillPosition(targetMatrix.id, userId);

      res.json({ success: true });
    } catch (err) {
      console.error("Error in /api/user/activate:", err);
      res.status(500).json({ error: "Erro ao ativar licença" });
    }
  });

