# ============================================
# Mobicyclo - Docker Environment Variables
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- MySQL ---
# Subir só o MySQL com docker run (Windows): npm run docker:mysql:pull && npm run docker:mysql:up
# Linux/mac: bash scripts/docker-mysql-up.sh
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=mobicyclo
MYSQL_USER=mobicyclo
MYSQL_PASSWORD=mobicyclo123

# --- Backend (Node.js/Express) ---
# npm run dev: use development. Docker Compose / imagem PM2 costumam forçar production no container.
NODE_ENV=development
PORT=3000
# MySQL acessível da sua máquina (dev local). O servidor de hospedagem do projeto usa este host.
# No Docker Compose o serviço `backend` define DB_HOST=db no compose — não depende deste valor no .env.
DB_HOST=187.77.254.38
# Opcional: host só para `npm run db:test` sem alterar DB_HOST (útil se DB_HOST=db no .env do Docker).
# DB_TEST_HOST=187.77.254.38
DB_PORT=3306
DB_USER=mobicyclo
DB_PASSWORD=mobicyclo123
DB_NAME=mobicyclo

# Redis: no Compose use redis://redis:6379. Local sem Docker: tente 127.0.0.1:6379 ou defina REDIS_DISABLED=1.
REDIS_URL=redis://127.0.0.1:6379
# Sem Redis rodando (ex.: Docker parado): em NODE_ENV=development o servidor segue sem Redis (rate limit em RAM).
# Para falhar de propósito se Redis estiver offline, use NODE_ENV=production localmente (não recomendado).
# REDIS_DISABLED=1
# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Portas expostas no Docker ---
DB_EXTERNAL_PORT=3306
BACKEND_PORT=3000
FRONTEND_PORT=80

# --- Dozzle Monitoring ---
DOZZLE_AUTH_USER=zecarlos
DOZZLE_AUTH_PASSWORD=

# --- Telegram Backup ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mercado Pago (API de pagamentos / webhooks) ---
# Credenciais: https://www.mercadopago.com.br/developers/panel/app
# Abaixo: credenciais de TESTE do painel (sandbox). Em repositório público, use placeholders e copie só para .env local.
#
# Importante: o Mercado Pago pode POSTar no webhook com sucesso mesmo quando GET /v1/payments/:id
# devolve 404 no seu servidor. Isso acontece se MERCADOPAGO_ACCESS_TOKEN não for do MESMO aplicativo
# e da MESMA aba (Credenciais de teste vs Credenciais de produção) que originou o pagamento.
# MERCADOPAGO_WEBHOOK_SECRET (se usar) e o Access Token devem ser da mesma aplicação no painel.
# Após alterar o token no .env, reinicie o Node (o SDK cacheia o client na primeira chamada).
MERCADOPAGO_ACCESS_TOKEN=TEST-2317447139451965-040517-67570b6867f1bc6a61e2c8d622ddad26-2329866256
MERCADOPAGO_PUBLIC_KEY=TEST-4543509d-3c24-4809-9e2f-93650e1a067a

# Usado em back_urls e notification_url do Checkout Pro (deve ser a URL pública que o MP alcança).
APP_PUBLIC_URL=https://randee-requitable-semiproductively.ngrok-free.dev

# Nome exato (sem underscore entre MERCADO e PAGO) — igual ao lido em server.ts e notifications.ts
MERCADOPAGO_WEBHOOK_SECRET=71c9848fbbe3934dbb05354486f2cfcf8ce21b37451e0df0dd59fcbf78d4f070
# Painel de teste com APP_USR-: habilite para npm run mp:utils-test (tokens TEST- não precisam)
MERCADOPAGO_ALLOW_APP_USR_IN_UTILS_TEST=1
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Comprador de teste (painel MP). Usado em: npm run mp:utils-test
# MERCADOPAGO_TEST_PAYER_EMAIL=
# Opcional: validação de notificações (x-signature) — ver MERCADOPAGO_WEBHOOK_SECRET acima
# Base pública da API (quase sempre o default; só mudar se a documentação MP pedir)
# MERCADOPAGO_API_BASE=https://api.mercadopago.com
# URL pública do app (back_urls / webhooks Checkout Pro)
# APP_PUBLIC_URL=http://localhost:3000
