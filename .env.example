# ============================================
# Mobicyclo - Docker Environment Variables
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- MySQL ---
# Subir só o MySQL com docker run (Windows): npm run docker:mysql:pull && npm run docker:mysql:up
# Linux/mac: bash scripts/docker-mysql-up.sh
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=mobicyclo
MYSQL_USER=mobicyclo
MYSQL_PASSWORD=mobicyclo123

# --- Backend (Node.js/Express) ---
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=3306
DB_USER=mobicyclo
DB_PASSWORD=mobicyclo123
DB_NAME=mobicyclo


# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Portas expostas no Docker ---
DB_EXTERNAL_PORT=3306
BACKEND_PORT=3000
FRONTEND_PORT=80

# --- Dozzle Monitoring ---
DOZZLE_AUTH_USER=zecarlos
DOZZLE_AUTH_PASSWORD=

# --- Telegram Backup ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mercado Pago (API de pagamentos / webhooks) ---
# Credenciais: https://www.mercadopago.com.br/developers/panel/app
# Abaixo: credenciais de TESTE do painel (sandbox). Em repositório público, use placeholders e copie só para .env local.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-2317447139451965-040517-d681bcd2cb5bba39f1abec12c2e4e0dc-2329866256
MERCADOPAGO_PUBLIC_KEY=APP_USR-d41a2404-2c85-491e-91d0-16cf628e0234
# Painel de teste com APP_USR-: habilite para npm run mp:utils-test (tokens TEST- não precisam)
MERCADOPAGO_ALLOW_APP_USR_IN_UTILS_TEST=1
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Comprador de teste (painel MP). Usado em: npm run mp:utils-test
# MERCADOPAGO_TEST_PAYER_EMAIL=
# Opcional: validação de notificações (se o painel / docs da sua integração fornecer segredo ou assinatura)
# MERCADOPAGO_WEBHOOK_SECRET=
# Base pública da API (quase sempre o default; só mudar se a documentação MP pedir)
# MERCADOPAGO_API_BASE=https://api.mercadopago.com
# URL pública do app (back_urls / webhooks Checkout Pro)
# APP_PUBLIC_URL=http://localhost:3000
