# ============================================
# Mobicyclo - Docker Environment Variables
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=mobicyclo
MYSQL_USER=mobicyclo
MYSQL_PASSWORD=mobicyclo123

# --- Backend (Node.js/Express) ---
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=3306
DB_USER=mobicyclo
DB_PASSWORD=mobicyclo123
DB_NAME=mobicyclo


# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Portas expostas no Docker ---
DB_EXTERNAL_PORT=3306
BACKEND_PORT=3000
FRONTEND_PORT=80

# --- Dozzle Monitoring ---
DOZZLE_AUTH_USER=zecarlos
DOZZLE_AUTH_PASSWORD=

# --- Telegram Backup ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
